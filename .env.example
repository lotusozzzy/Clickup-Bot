# Bu dosyayı .env olarak kopyala ve gerçek değerleri doldur.
# .env dosyası .gitignore'da, asla commit edilmez.

# ZORUNLU
CLICKUP_API_TOKEN=pk_xxxxx
SMTP_PASSWORD=xxxxx

